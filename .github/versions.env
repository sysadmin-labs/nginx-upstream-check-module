# Version and digest pins for every workflow in this repository.
#
# SINGLE SOURCE OF TRUTH.  A workflow takes every version from here,
# through .github/scripts/pins.sh where a matrix needs it and by sourcing
# this file where a step needs it; ci/build.sh reads it too, so a local run
# verifies the same way a continuous integration run does.
#
# Version and digest sit on adjacent lines on purpose: they are changed by
# one hand in one file, so a version cannot move while its digest stays
# behind.
#
# WHAT THE DIGESTS DO AND DO NOT PROVE.  They pin what we build against: a
# changed archive, a truncated download or a poisoned build cache fails the
# build instead of being compiled.  They say nothing about provenance.
# nginx.org publishes a detached signature next to each archive
# (nginx-<version>.tar.gz.asc) and that is what would prove it; this does
# not check it.
#
# WHICH RELEASES.  Only the two lines the core patch is kept against, which
# are the two the FreeBSD ports tree ships: the stable 1.30 line and the
# mainline 1.31 line.  This module patches nginx itself, so an untested
# release is not "probably fine" here the way it is for a module that only
# uses the public interface.
#
# Keep KEY=value, no spaces around the equals sign.  The file is SOURCED by
# ci/build.sh and by the workflow steps that need a version, so a value
# with a space in it needs quoting.

NGINX_VERSIONS="1.30.6 1.31.8"
NGINX_1_30_6_SHA256=3cf46f5ed7504d460125866b7bea99fb357f31d887e2e63b35503310e9b8b6c8
NGINX_1_31_8_SHA256=0652b760b3b772d2ec17b47c2fc15d9a95e6fe35cd5b877eadc1a62d9bc75af1

# The single release the deeper gates run against: what www/nginx ships.
NGINX_VERSION=1.30.6

ACTIONLINT_VERSION=1.7.7
ACTIONLINT_SHA256=023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757
